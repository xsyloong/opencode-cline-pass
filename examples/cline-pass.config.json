{
  "displayName": "Cline Pass",
  "baseURL": "https://api.cline.bot/api/v1",
  "apiKeyEnv": "CLINE_PASS_API_KEY",
  "accountMode": "roundrobin",
  "accounts": {
    "main": {
      "displayName": "Main",
      "apiKeyEnv": "CLINE_PASS_MAIN_KEY",
      "enabled": true,
      "baseURL": ""
    },
    "backup": {
      "displayName": "Backup",
      "apiKeyEnv": "CLINE_PASS_BACKUP_KEY",
      "enabled": true,
      "baseURL": ""
    }
  },
  "hiddenModels": [
    "cline-pass/kimi-k3"
  ],
  "pinCapabilities": [
    "vision"
  ],
  "modelAliases": {
    "cline-pass/deepseek-v4.1-flash-1017-open": "deepseek/deepseek-v4.1-flash-1017"
  },
  "perModel": {
    "cline-pass/glm-5.2": {
      "upstreams": [
        "alibaba",
        "baseten"
      ],
      "exclude": [
        "deepseek"
      ],
      "pinMode": "preferred",
      "sort": "ttft",
      "capabilities": [
        "vision"
      ]
